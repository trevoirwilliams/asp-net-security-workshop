@{
    ViewData["Title"] = "Policy Demo";
}

<h2>Policy Demo</h2>
<p>You passed the <strong>DemoPolicy</strong> check, which requires:</p>
<ul>
    <li>Authenticated user</li>
    <li>Member of the <strong>Administrator</strong> role</li>
    <li>Claim: <strong>Permission = CanAccessAdminPanel</strong></li>
</ul>

<hr />
<h4>Your current claims</h4>
<table class="table table-sm table-bordered">
    <thead>
        <tr>
            <th>Type</th>
            <th>Value</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var claim in User.Claims)
        {
            <tr>
                <td>@claim.Type</td>
                <td>@claim.Value</td>
            </tr>
        }
    </tbody>
</table>
