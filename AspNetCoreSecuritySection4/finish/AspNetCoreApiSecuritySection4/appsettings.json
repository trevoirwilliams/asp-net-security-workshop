{
  "ConnectionStrings": {
    "DefaultConnection": "DataSource=app.db;Cache=Shared"
  },
  "Jwt": {
    "Issuer": "AspNetCoreApiSecuritySection4",
    "Audience": "AspNetCoreApiSecuritySection4.Client",
    "SigningKey": "ReplaceThisWithASecretKeyAtLeast32CharactersLong",
    "ExpirationMinutes": 1
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
