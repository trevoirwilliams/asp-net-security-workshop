@{
    ViewData["Title"] = "Survey Submitted";
}

<div class="text-center mt-5">
    <div class="alert alert-success d-inline-block px-5 py-4" role="alert">
        <h4 class="alert-heading">Thank you!</h4>
        <p>@(TempData["SuccessMessage"] ?? "Your survey has been submitted.")</p>
    </div>
    <div class="mt-3">
        <a asp-action="Create" class="btn btn-outline-primary me-2">Submit Another</a>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Home</a>
    </div>
</div>
