@model AspNetCoreSecuritySection3.ViewModels.ProductReviewInputModel

@{
    ViewData["Title"] = "Write a Review";
}

<h2 class="mb-4">Write a Product Review</h2>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="mb-3">
                <label asp-for="ProductName" class="form-label"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReviewerName" class="form-label"></label>
                <input asp-for="ReviewerName" class="form-control" />
                <span asp-validation-for="ReviewerName" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Rating" class="form-label">Rating (1–5)</label>
                <input asp-for="Rating" class="form-control" type="number" min="1" max="5" />
                <span asp-validation-for="Rating" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReviewText" class="form-label"></label>
                <textarea asp-for="ReviewText" class="form-control" rows="5"></textarea>
                <span asp-validation-for="ReviewText" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success">Submit Review</button>
            <a asp-controller="Home" asp-action="Index" class="btn btn-link">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
