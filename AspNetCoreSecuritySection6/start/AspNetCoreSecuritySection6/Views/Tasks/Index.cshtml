@{
    ViewData["Title"] = "Tasks";
}
@model IEnumerable<AspNetCoreSecuritySection6.Models.TaskItem>

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks</h2>
        <a asp-action="Create" class="btn btn-primary">+ New Task</a>
    </div>

    @if (!Model.Any())
    {
        <p class="text-muted">No tasks found.</p>
    }
    else
    {
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Status</th>
                    <th>Due Date</th>
                    <th>Owner</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var task in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td>
                        <td>
                            <span class="badge @(task.IsCompleted ? "bg-success" : task.Status == AspNetCoreSecuritySection6.Models.TaskStatus.InProgress ? "bg-warning text-dark" : "bg-secondary")">
                                @task.Status
                            </span>
                        </td>
                        <td>@task.DueDate?.ToString("yyyy-MM-dd")</td>
                        <td>@task.Owner?.Email</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@task.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <a asp-controller="Export" asp-action="Tasks" class="btn btn-outline-secondary btn-sm">Export CSV</a>
</div>
