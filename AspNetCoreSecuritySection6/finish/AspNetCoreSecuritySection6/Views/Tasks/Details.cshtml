@{
    ViewData["Title"] = "Task Details";
}
@model AspNetCoreSecuritySection6.Models.TaskItem

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h2>@Model.Title</h2>
            <span class="badge @(Model.IsCompleted ? "bg-success" : "bg-secondary") fs-6">@Model.Status</span>
        </div>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-secondary me-1">Edit</a>
            @if (!Model.IsCompleted)
            {
                <form asp-action="Complete" asp-route-id="@Model.Id" method="post" class="d-inline">
                    <button type="submit" class="btn btn-success">Mark Complete</button>
                </form>
            }
        </div>
    </div>

    <dl class="row">
        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@(Model.Description ?? "—")</dd>

        <dt class="col-sm-3">Owner</dt>
        <dd class="col-sm-9">@Model.Owner?.Email</dd>

        <dt class="col-sm-3">Created</dt>
        <dd class="col-sm-9">@Model.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</dd>

        <dt class="col-sm-3">Due Date</dt>
        <dd class="col-sm-9">@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "—")</dd>

        @if (Model.IsCompleted)
        {
            <dt class="col-sm-3">Completed</dt>
            <dd class="col-sm-9">@Model.CompletedAtUtc?.ToString("yyyy-MM-dd HH:mm") UTC</dd>
        }
    </dl>

    <hr />

    <!-- COMMENTS SECTION -->
    <h4>Comments</h4>
    @if (!Model.Comments.Any())
    {
        <p class="text-muted">No comments yet.</p>
    }
    else
    {
        @foreach (var comment in Model.Comments.OrderBy(c => c.CreatedAtUtc))
        {
            <div class="card mb-2">
                <div class="card-body py-2">
                    <small class="text-muted">@comment.Author?.Email — @comment.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm")</small>
                    <p class="mb-0">@comment.Body</p>
                </div>
            </div>
        }
    }

    <form asp-action="AddComment" method="post" class="mt-3">
        <input type="hidden" name="taskId" value="@Model.Id" />
        <div class="mb-2">
            <textarea name="body" class="form-control" rows="2" placeholder="Add a comment..." required></textarea>
        </div>
        <button type="submit" class="btn btn-outline-primary btn-sm">Post Comment</button>
    </form>

    <hr />

    <!-- ATTACHMENTS SECTION -->
    <h4>Attachments</h4>
    @if (!Model.Attachments.Any())
    {
        <p class="text-muted">No attachments yet.</p>
    }
    else
    {
        <ul class="list-group mb-3">
            @foreach (var att in Model.Attachments.OrderBy(a => a.UploadedAtUtc))
            {
                <li class="list-group-item d-flex justify-content-between">
                    <span>
                        @* SR-09: Route through the controller action so authorisation is
                           always enforced — files are no longer publicly addressable *@
                        <a asp-action="DownloadAttachment" asp-route-id="@att.Id">@att.OriginalFileName</a>
                        <small class="text-muted ms-2">(@(att.FileSizeBytes / 1024) KB)</small>
                    </span>
                    <small class="text-muted">@att.UploadedBy?.Email — @att.UploadedAtUtc.ToString("yyyy-MM-dd")</small>
                </li>
            }
        </ul>
    }

    <!-- UPLOAD ATTACHMENT FORM -->
    <form asp-action="UploadAttachment" method="post" enctype="multipart/form-data" class="mt-2">
        <input type="hidden" name="taskId" value="@Model.Id" />
        <div class="input-group">
            <input type="file" name="file" class="form-control" />
            <button type="submit" class="btn btn-outline-secondary">Upload</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-link">← Back to Tasks</a>
    </div>
</div>
