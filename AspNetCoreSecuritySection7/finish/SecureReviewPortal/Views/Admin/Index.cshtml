@model IReadOnlyList<SecurityReviewRequest>
@{
    ViewData["Title"] = "Admin Console";
}

<h2>Admin Console</h2>
<p class="text-muted">Manage all requests and navigate to checklist management.</p>

<div class="mb-3">
    <a class="btn btn-primary" asp-controller="ReviewChecklist" asp-action="Create">Add Checklist Item</a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Request</th>
            <th>Owner</th>
            <th>Status</th>
            <th>Classification</th>
            <th>Updated</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var request in Model)
    {
        <tr>
            <td>@request.Title</td>
            <td>@request.OwnerUser?.Email</td>
            <td>@request.Status</td>
            <td>@request.DataClassification</td>
            <td>@request.LastUpdatedAtUtc.ToString("u")</td>
            <td><a class="btn btn-sm btn-outline-primary" asp-controller="SecurityReviewRequests" asp-action="Details" asp-route-id="@request.Id">Details</a></td>
        </tr>
    }
    </tbody>
</table>
