@model SecurityReviewRequest
@{
    ViewData["Title"] = "Review Request";
}

<h2>@Model.Title</h2>
<p class="text-muted">Status: @Model.Status | Owner: @Model.OwnerUser?.Email</p>

<div class="card mb-3">
    <div class="card-body">
        <h5>Description</h5>
        <p>@Model.Description</p>
        <h5>Business Justification</h5>
        <p class="mb-0">@Model.BusinessJustification</p>
    </div>
</div>

<div class="mb-3">
    <a class="btn btn-success" asp-action="Create" asp-route-requestId="@Model.Id">Add Finding</a>
    <a class="btn btn-outline-secondary" asp-controller="SecurityReviewRequests" asp-action="Details" asp-route-id="@Model.Id">Open Full Details</a>
</div>

<h4>Existing Findings</h4>
@if (!Model.Findings.Any())
{
    <p class="text-muted">No findings recorded yet.</p>
}
else
{
    <table class="table table-sm table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Severity</th>
                <th>Status</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var finding in Model.Findings.OrderByDescending(f => f.CreatedAtUtc))
        {
            <tr>
                <td>@finding.Title</td>
                <td>@finding.Severity</td>
                <td>@finding.Status</td>
                <td>@finding.Source</td>
            </tr>
        }
        </tbody>
    </table>
}
