@model ReviewChecklistItemViewModel
@{
    ViewData["Title"] = "Add Checklist Item";
}

<h2>Add Checklist Item</h2>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ReviewQuestion" class="form-label"></label>
        <textarea asp-for="ReviewQuestion" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ReviewQuestion" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ExpectedProtection" class="form-label"></label>
        <textarea asp-for="ExpectedProtection" class="form-control" rows="3"></textarea>
        <span asp-validation-for="ExpectedProtection" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SortOrder" class="form-label"></label>
        <input asp-for="SortOrder" class="form-control" />
        <span asp-validation-for="SortOrder" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Add Item</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
