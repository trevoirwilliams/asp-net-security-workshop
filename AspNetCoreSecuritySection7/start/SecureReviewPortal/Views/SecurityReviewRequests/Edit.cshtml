@model EditReviewRequestViewModel
@{
    ViewData["Title"] = "Edit Review Request";
}

<h2>Edit Review Request</h2>

<form asp-action="Edit" method="post">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SystemName" class="form-label"></label>
        <input asp-for="SystemName" class="form-control" />
        <span asp-validation-for="SystemName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DataClassification" class="form-label"></label>
        <select asp-for="DataClassification" asp-items="Html.GetEnumSelectList<DataClassification>()" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" rows="4" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="BusinessJustification" class="form-label"></label>
        <textarea asp-for="BusinessJustification" rows="4" class="form-control"></textarea>
        <span asp-validation-for="BusinessJustification" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Save Changes</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
