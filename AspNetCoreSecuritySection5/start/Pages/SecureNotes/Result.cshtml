@page
@model AspNetCoreSecuritySection5.Pages.SecureNotes.ResultModel
@{
    ViewData["Title"] = "Note Created";
}

<h1>Secure Note Created Successfully</h1>

@if (Model.Note != null)
{
    <div class="alert alert-success">
        Your secure note has been created and saved.
    </div>

    <div class="card">
        <div class="card-body">
            <p><strong>Title:</strong> @Model.Note.Title</p>
            <p><strong>Recipient Email:</strong> @Model.Note.RecipientEmail</p>
            <p><strong>Note ID:</strong> @Model.Note.Id</p>
            <p><strong>Created:</strong> @Model.Note.CreatedUtc:G</p>
        </div>
    </div>

    <a href="/SecureNotes/Create" class="btn btn-primary mt-3">Create Another Note</a>
}
else
{
    <div class="alert alert-warning">
        Note not found.
    </div>
}
