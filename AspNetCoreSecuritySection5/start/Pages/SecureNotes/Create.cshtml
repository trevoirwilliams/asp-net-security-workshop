@page
@model AspNetCoreSecuritySection5.Pages.SecureNotes.CreateModel
@{
    ViewData["Title"] = "Create Secure Note";
}

<h1>Create Secure Note</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label"></label>
                <input asp-for="Input.Title" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.RecipientEmail" class="form-label"></label>
                <input asp-for="Input.RecipientEmail" class="form-control" />
                <span asp-validation-for="Input.RecipientEmail" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PlainTextNote" class="form-label"></label>
                <textarea asp-for="Input.PlainTextNote" class="form-control" rows="5"></textarea>
                <span asp-validation-for="Input.PlainTextNote" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Create Note</button>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
