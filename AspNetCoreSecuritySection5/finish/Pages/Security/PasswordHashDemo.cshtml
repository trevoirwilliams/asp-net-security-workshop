@page
@model AspNetCoreSecuritySection5.Pages.Security.PasswordHashDemoModel
@{
    ViewData["Title"] = "Password Hash Demo";
}

<h1>Password Hash Demo</h1>

<p class="text-muted">
    Enter a password to see how the application hashes and verifies it.
</p>

<form method="post" class="mb-4">
    <div class="mb-3">
        <label for="enteredPassword" class="form-label">Enter a Password</label>
        <input type="password" id="enteredPassword" class="form-control" asp-for="EnteredPassword" required />
        <span asp-validation-for="EnteredPassword" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Hash and Verify</button>
</form>

@if (Model.HasProcessed)
{
    <div class="card mb-3">
        <div class="card-header">
            <strong>Results</strong>
        </div>
        <div class="card-body">
            <p><strong>Entered Password:</strong> <code>@Model.EnteredPassword</code></p>
            <p><strong>Generated Hash:</strong></p>
            <p><code class="d-block text-break" style="font-size: 0.85rem; word-break: break-all;">@Model.GeneratedHash</code></p>

            <hr />

            <p><strong>Verification Results:</strong></p>
            <ul class="list-unstyled">
                <li>
                    Correct password verified:
                    @if (Model.CorrectPasswordVerified)
                    {
                        <span class="badge bg-success">✓ Success</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">✗ Failed</span>
                    }
                </li>
                <li>
                    Wrong password verified:
                    @if (!Model.WrongPasswordVerified)
                    {
                        <span class="badge bg-success">✓ Correctly Failed</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">✗ Unexpectedly Passed</span>
                    }
                </li>
            </ul>
        </div>
    </div>
}